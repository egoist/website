---
import { Image } from "astro:assets"
import avatar from "~/assets/avatar.jpeg"
import { cn } from "~/lib/utils"

const nav = [
  { label: "About", href: "/about" },
  { label: "Uses", href: "/uses" },
  { label: "Donate", href: "/donate" },
  { label: "RSS", href: "/rss.xml" },
]

const isActive = (href: string) =>
  Astro.url.pathname === href || Astro.url.pathname === `${href}/`
---

<header class="flex items-center justify-between text-sm">
  <a href="/" class="group flex items-center gap-2.5 font-medium">
    <Image
      src={avatar}
      class="size-6 rounded-full grayscale transition duration-300 group-hover:grayscale-0"
      alt="egoist"
    />
    <span>EGOIST</span>
  </a>
  <nav class="flex items-center gap-5">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class={cn(
            "transition-colors duration-200",
            isActive(item.href) ? "text-fg" : "text-muted hover:text-fg",
          )}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
