---
import { getSponsors } from "~/lib/get-sponsors"
import thanksGif from "~/assets/thanks.gif"
import { Image } from "astro:assets"
import BlogLayout from "~/layouts/BlogLayout.astro"

const normalizeNewLine = (v: string) => v.replace(/\r\n/g, "\n")

const sponsors = await getSponsors()
---

<BlogLayout title="Donate">
  <div class="prose">
    <p>
      I’m truly grateful to all the wonderful humans and companies supporting my
      open source work on{" "}
      <a
        href="https://github.com/sponsors/egoist"
        target="_blank"
        rel="nofollow noopener"
      >
        GitHub Sponsors
      </a>
    </p>
    <p>
      <Image
        src={thanksGif}
        width={550}
        height={250}
        alt="thanks in multiple languages"
      />
    </p>
  </div>
  <div class="mt-16 space-y-14">
    {
      sponsors.map(({ tier, sponsors }) => {
        return (
          <section>
            <h3 class="mb-4 text-sm text-muted tabular-nums">${tier} / month</h3>
            <ul class="space-y-4">
              {sponsors.map((sponsor: any) => {
                const bio = sponsor.bio || sponsor.description
                return (
                  <li class="flex items-start gap-3">
                    <img
                      src={sponsor.avatarUrl}
                      height={32}
                      width={32}
                      loading="lazy"
                      class="mt-0.5 size-8 shrink-0 rounded-full bg-subtle"
                      alt={`profile image of ${sponsor.login}`}
                    />
                    <div class="min-w-0 text-[15px] leading-6">
                      <a
                        href={`https://github.com/${sponsor.login}`}
                        rel="nofollow noopener"
                        target="_blank"
                        class="link"
                      >
                        {sponsor.name || sponsor.login}
                      </a>
                      {sponsor.name && (
                        <span class="ml-1.5 text-faint">@{sponsor.login}</span>
                      )}
                      {bio && (
                        <p class="text-sm text-muted whitespace-pre-line">
                          {normalizeNewLine(bio)}
                        </p>
                      )}
                    </div>
                  </li>
                )
              })}
            </ul>
          </section>
        )
      })
    }
  </div>
</BlogLayout>
