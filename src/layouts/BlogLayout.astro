---
import "@fontsource-variable/inter"
import "@fontsource-variable/geist-mono"
import "../css/tailwind.css"
import "../css/page.css"
import dayjs from "dayjs"
import SidebarNav from "~/components/SidebarNav.astro"
import { site } from "~/config"
import type { MarkdownHeading } from "astro"
import { getImagePath } from "astro-opengraph-images"

interface Props {
  title?: string
  description?: string
  meta?: {
    title?: string
  }
  date?: string | Date
  headings?: MarkdownHeading[]
  isPost?: boolean
  lang?: string
}

const { title, date, meta, headings, isPost, lang } = Astro.props

const documentTitle = meta?.title || `${title} - ${site.title}`
const description = Astro.props.description || site.description

const openGraphImageUrl = getImagePath({ url: Astro.url, site: Astro.site })
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <title>{documentTitle}</title>
    <link rel="icon" href="/favicon_v3.jpeg" type="image/jpeg" sizes="80x80" />
    <meta name="twitter:card" content="summary" />
    <meta property="og:title" content={title || site.title} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content={isPost ? "article" : "website"} />
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed for EGOIST's Blog"
      href={`${Astro.site}rss.xml`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="image" content={openGraphImageUrl} />
    <meta itemprop="image" content={openGraphImageUrl} />
    <meta name="twitter:image" content={openGraphImageUrl} />
    <meta property="og:image" content={openGraphImageUrl} />
    <meta name="google-adsense-account" content="ca-pub-7003521480797900" />
  </head>
  <body>
    <div class="mx-auto max-w-page px-5 pt-10 pb-16 sm:pt-16">
      <SidebarNav />

      {
        headings && headings.length > 2 && (
          <aside class="fixed top-40 hidden w-44 -translate-x-[calc(100%+4rem)] xl:block">
            <ul class="space-y-2 text-[13px] leading-snug">
              {headings
                .filter((heading) => heading.depth <= 3)
                .map((heading) => (
                  <li style={{ paddingLeft: `${(heading.depth - 2) * 12}px` }}>
                    <a
                      class="block text-faint transition-colors duration-200 hover:text-fg"
                      href={`#${heading.slug}`}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
            </ul>
          </aside>
        )
      }

      <main class="reveal mt-20 sm:mt-24">
        {
          (title || date) && (
            <header class="mb-12">
              {title && (
                <h1 class="text-[22px] font-semibold leading-tight tracking-tight text-balance">
                  {title}
                </h1>
              )}
              {date && (
                <time
                  datetime={dayjs(date).format("YYYY-MM-DD")}
                  class="mt-2 block text-sm text-muted tabular-nums"
                >
                  {dayjs(date).format("MMMM D, YYYY")}
                </time>
              )}
            </header>
          )
        }
        <div><slot /></div>
      </main>

      <footer class="mt-28 flex items-center justify-between text-[13px] text-faint">
        <span>&copy; {new Date().getFullYear()} EGOIST</span>
        <div class="flex gap-4">
          <a href={`https://github.com/${site.github}`} class="transition-colors hover:text-fg">GitHub</a>
          <a href={`https://x.com/${site.twitter}`} class="transition-colors hover:text-fg">X</a>
          <a href={`mailto:${site.email}`} class="transition-colors hover:text-fg">Email</a>
        </div>
      </footer>
    </div>

    {import.meta.env.PROD && <script defer src="/_vercel/insights/script.js" />}

    {
      import.meta.env.PROD && (
        <script
          async
          defer
          src="https://umami2.egoist.dev/script.js"
          data-website-id="d345d161-6ebc-417c-b1f3-d157b21fdbb1"
        />
      )
    }

    {
      import.meta.env.PROD && (
        <script async src="https://cdn.seline.so/seline.js" />
      )
    }
  </body>
</html>
